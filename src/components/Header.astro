---
import { getLangFromUrl, useTranslations, localizePath, stripLangPrefix } from '../i18n/utils';
import ThemeToggle from './ThemeToggle.astro';
import LangSwitcher from './LangSwitcher.astro';
import { site } from '../data/site';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const links = [
  { href: localizePath('/', lang), label: t('nav.home'), key: 'home' },
  { href: localizePath('/proyectos/', lang), label: t('nav.projects'), key: 'projects' },
  { href: localizePath('/habilidades/', lang), label: t('nav.skills'), key: 'skills' },
  { href: localizePath('/blog/', lang), label: t('nav.blog'), key: 'blog' },
  { href: localizePath('/contacto/', lang), label: t('nav.contact'), key: 'contact' },
];

const pathname = Astro.url.pathname;
const isActive = (href: string) => {
  const current = stripLangPrefix(pathname).replace(/\/$/, '') || '/';
  const target = stripLangPrefix(href).replace(/\/$/, '') || '/';
  return current === target;
};
---

<header class="sticky top-0 z-50 border-b border-line bg-bg/80 backdrop-blur-md">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-4">
    <a href={localizePath('/', lang)} class="font-mono text-sm font-medium tracking-tight hover:text-accent transition-colors">
      <span class="text-accent">~/</span>{site.name}
    </a>

    <nav class="hidden md:flex items-center gap-1">
      {
        links.map((link) => (
          <a
            href={link.href}
            class:list={[
              'px-3 py-1.5 text-sm rounded-md transition-colors',
              isActive(link.href)
                ? 'text-accent bg-accent-soft'
                : 'text-muted hover:text-ink hover:bg-bg-soft',
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-1.5">
      <LangSwitcher />
      <ThemeToggle />
      <button
        type="button"
        data-menu-toggle
        class="md:hidden inline-flex h-9 w-9 items-center justify-center rounded-md border border-line text-muted hover:text-ink transition-colors"
        aria-label={t('nav.menu')}
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <nav data-mobile-nav class="hidden md:hidden border-t border-line bg-bg-soft px-4 py-3">
    {
      links.map((link) => (
        <a
          href={link.href}
          class:list={[
            'block px-3 py-2 text-sm rounded-md',
            isActive(link.href) ? 'text-accent bg-accent-soft' : 'text-muted hover:text-ink',
          ]}
        >
          {link.label}
        </a>
      ))
    }
  </nav>
</header>
