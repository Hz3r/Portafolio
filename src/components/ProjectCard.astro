---
import type { CollectionEntry } from 'astro:content';
import { localizePath, getLangFromUrl, formatDate } from '../i18n/utils';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const description = lang === 'en' ? project.data.descriptionEn : project.data.description;
---

<article class="group relative flex flex-col rounded-xl border border-line bg-surface overflow-hidden glow-ring transition-all hover:-translate-y-0.5 hover:border-accent/40">
  {
    project.data.cover && (
      <div class="aspect-[16/9] border-b border-line bg-bg-soft overflow-hidden">
        <img
          src={project.data.cover}
          alt=""
          loading="lazy"
          class="h-full w-full object-cover opacity-90 group-hover:opacity-100 transition-opacity"
        />
      </div>
    )
  }
  <div class="flex flex-1 flex-col p-5 gap-3">
    <div class="flex items-start justify-between gap-3">
      <h3 class="text-lg font-semibold leading-snug">
        <a href={localizePath(`/proyectos/${project.id}/`, lang)} class="hover:text-accent transition-colors">
          {project.data.title}
          <span class="absolute inset-0" aria-hidden="true"></span>
        </a>
      </h3>
      <time class="font-mono text-xs text-muted shrink-0 pt-1" datetime={project.data.pubDate.toISOString()}>
        {formatDate(project.data.pubDate, lang)}
      </time>
    </div>

    <p class="text-sm text-muted leading-relaxed flex-1">{description}</p>

    <ul class="flex flex-wrap gap-1.5">
      {
        project.data.tags.slice(0, 5).map((tag) => (
          <li class="rounded-md border border-line bg-bg-soft px-2 py-0.5 font-mono text-[11px] text-muted">
            {tag}
          </li>
        ))
      }
    </ul>
  </div>
</article>
