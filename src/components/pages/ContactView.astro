---
import ContactForm from '../ContactForm.astro';
import { useTranslations, type Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<div class="max-w-2xl">
  <header class="mb-10">
    <p class="font-mono text-xs uppercase tracking-widest text-accent mb-3">~/contact</p>
    <h1 class="text-3xl sm:text-4xl font-bold tracking-tight">{t('contact.title')}</h1>
    <p class="mt-3 text-muted leading-relaxed">{t('contact.description')}</p>
  </header>

  <ContactForm />
</div>
