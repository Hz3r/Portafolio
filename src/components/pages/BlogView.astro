---
import type { CollectionEntry } from 'astro:content';
import BlogCard from '../BlogCard.astro';
import { useTranslations, type Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
  posts: CollectionEntry<'blog'>[];
}

const { lang, posts } = Astro.props;
const t = useTranslations(lang);
---

<header class="mb-10">
  <p class="font-mono text-xs uppercase tracking-widest text-accent mb-3">~/blog</p>
  <h1 class="text-3xl sm:text-4xl font-bold tracking-tight">{t('blog.title')}</h1>
  <p class="mt-3 text-muted max-w-2xl leading-relaxed">{t('blog.description')}</p>
</header>

{
  posts.length === 0 ? (
    <p class="text-muted">{t('blog.empty')}</p>
  ) : (
    <div class="grid sm:grid-cols-2 gap-5">
      {posts.map((post) => (
        <BlogCard post={post} />
      ))}
    </div>
  )
}
