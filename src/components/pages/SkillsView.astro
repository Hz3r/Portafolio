---
import { useTranslations, type Lang } from '../../i18n/utils';
import { skillGroups } from '../../data/skills';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<header class="mb-10">
  <p class="font-mono text-xs uppercase tracking-widest text-accent mb-3">~/skills</p>
  <h1 class="text-3xl sm:text-4xl font-bold tracking-tight">{t('skills.title')}</h1>
  <p class="mt-3 text-muted max-w-2xl leading-relaxed">{t('skills.description')}</p>
</header>

<div class="grid sm:grid-cols-2 gap-5">
  {
    skillGroups.map((group, i) => (
      <section
        class:list={[
          'rounded-xl border border-line bg-surface p-6 glow-ring',
          i === skillGroups.length - 1 && skillGroups.length % 2 === 1 && 'sm:col-span-2',
        ]}
      >
        <div class="flex items-center gap-2 mb-4">
          <span class="h-1.5 w-1.5 rounded-full bg-accent" />
          <h2 class="font-mono text-xs uppercase tracking-widest text-accent">{group.name[lang]}</h2>
        </div>
        <ul class="flex flex-wrap gap-2">
          {group.items.map((item) => (
            <li class="rounded-lg border border-line bg-bg-soft px-3 py-1.5 text-sm text-ink">{item}</li>
          ))}
        </ul>
      </section>
    ))
  }
</div>
